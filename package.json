{
  "name": "chrome-ad-blocker",
  "version": "0.1.0",
  "description": "Lightweight, privacy-first Chrome ad blocker extension (MV3)",
  "main": "src/manifest.json",
  "scripts": {
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "benchmark": "node tests/performance/benchmarks.js",
    "lint": "eslint src tests",
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production"
  },
  "keywords": [
    "chrome",
    "extension",
    "ad-blocker",
    "privacy",
    "mv3"
  ],
  "author": "Ad Blocker Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "benchmark": "^2.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
